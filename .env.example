# --- Core ---
# sqlite:///./dev.db for local dev; postgresql+psycopg://... in deployment
ENGINE_DATABASE_URL=sqlite:///./dev.db
# Shared-secret bearer for internal api<->worker calls (rotate via *_PREVIOUS)
ENGINE_INTERNAL_SECRET=dev-internal-secret-change-me

# --- OpenAI (Muffy + agents). Without this the dev provider is used (no spend). ---
OPENAI_API_KEY=
ENGINE_MODEL=gpt-4o-mini
MUFFY_MODEL=gpt-4o

# --- Supabase human auth (laurel-haven Lovable Cloud project) ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# service role key used ONLY to verify owner role; never exposed to agents
SUPABASE_SERVICE_ROLE_KEY=

# --- Engine org seed ---
ENGINE_DEFAULT_ORG=laurel

# --- Worker ---
ENGINE_WORKER_POLL_SECONDS=2
ENGINE_TASK_TIMEOUT_SECONDS=600
ENGINE_MAX_RETRIES=3
