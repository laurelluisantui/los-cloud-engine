# --- Core ---
# sqlite:///./dev.db for local dev; postgresql+psycopg://... in deployment
ENGINE_DATABASE_URL=sqlite:///./dev.db
# Local docker-compose only: two distinct strong passwords (no default).
ENGINE_DB_ADMIN_PASSWORD=
ENGINE_DB_PASSWORD=
# Shared-secret bearer for internal api<->worker calls (rotate via *_PREVIOUS)
ENGINE_INTERNAL_SECRET=dev-internal-secret-change-me

# --- OpenAI (Muffy + agents). Without this the dev provider is used (no spend). ---
OPENAI_API_KEY=
ENGINE_MODEL=gpt-5.4-mini
MUFFY_MODEL=gpt-5.4-mini

# --- Supabase human auth (laurel-haven Lovable Cloud project) ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Owner role is read with the user's own JWT under Lovable's RLS.
# Exact existing Lovable site origin; no '*' with owner JWTs.
ENGINE_ALLOWED_ORIGINS=https://laurelluisant.formxlogic.com
# Optional in SQLite dev; REQUIRED for approval-gated skill writes on Postgres.
# Install a GitHub App / fine-grained token with Contents: read/write on ONLY
# the private los-cloud-engine repo. Never put the value in this file.
ENGINE_GITHUB_TOKEN=
ENGINE_GITHUB_REPO=laurelluisantui/los-cloud-engine
ENGINE_GITHUB_BRANCH=main

# --- Engine org seed ---
ENGINE_DEFAULT_ORG=laurel

# --- Worker ---
ENGINE_WORKER_POLL_SECONDS=2
ENGINE_TASK_TIMEOUT_SECONDS=600
ENGINE_MAX_RETRIES=3
